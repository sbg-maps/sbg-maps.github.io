# Fill in the values, copy to ~/.config/systemd/user/ and: systemctl --user enable --now sbg-maps-bot
# Public link: tailscale funnel --bg --https=10000 3790. Token: ~/.config/sbg-maps-bot/token
[Unit]
Description=SBG Maps community pack bot
After=network-online.target

[Service]
Environment=THREAD_ID=<thread id>
Environment=DATA_DIR=/media/F/gamedev/sbg-maps-community
Environment=PORT=3790
Environment=CLOUDFLARED=/home/loafer/.local/bin/cloudflared
Environment=PUBLIC_URL=https://<machine>.<tailnet>.ts.net:10000
Environment="GAME_MAPS=/media/G/SteamLibrary/steamapps/common/Super Battle Golf/SbgMaps/maps"
ExecStart=/media/F/gamedev/sbg-maps/community/.venv/bin/python -u /media/F/gamedev/sbg-maps/community/bot.py
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
